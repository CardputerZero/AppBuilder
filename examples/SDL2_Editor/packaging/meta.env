PKG_DESC="nano-style text editor for CardputerZero: scroll, selection, copy/paste, save (SDL2)"
PKG_DEPENDS="libsdl2-2.0-0, libsdl2-ttf-2.0-0, libwayland-client0, fonts-dejavu-core"
APP_NAME="Editor"
APP_EXEC=/usr/share/APPLaunch/bin/sdl2-editor
APP_TERMINAL=false
APP_ICON=share/images/sdl2-editor.png
