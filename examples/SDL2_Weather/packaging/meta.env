PKG_NAME=sdl2-weather
PKG_VERSION=0.1
PKG_REVISION=m5stack1
PKG_DESC="Current weather via Open-Meteo for CardputerZero (SDL2 + libcurl)"
PKG_DEPENDS="libsdl2-2.0-0, libsdl2-ttf-2.0-0, libcurl4, libwayland-client0, fonts-dejavu-core, ca-certificates"
APP_NAME="Weather"
